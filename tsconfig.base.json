{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@onion-initializr/lib": ["lib/index.ts"],
      "@onion-initializr/lib/domain": ["lib/domain/index.ts"],
      "@onion-initializr/lib/domain/*": ["lib/domain/*"],
      "@onion-initializr/lib/application": ["lib/application/index.ts"],
      "@onion-initializr/lib/application/*": ["lib/application/*"],
      "@gh-pages/domain": ["gh-pages/src/domain/index.ts"],
      "@gh-pages/application": ["gh-pages/src/application/index.ts"],
      "@gh-pages/infrastructure": ["gh-pages/src/infrastructure/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
