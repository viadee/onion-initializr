{
  "name": "@onion-initializr/cli",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cli/src",
  "projectType": "application",
  "tags": [
    "npm:public",
    "npm:onion",
    "npm:starter",
    "npm:architecture",
    "npm:design",
    "npm:zwiebel"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["cli/**/*.ts"]
      }
    },
    "generate-version": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/cli/src/application/configuration/generated-version.ts"
      ],
      "options": {
        "commands": ["node generate-version.js"],
        "cwd": "cli"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["@onion-initializr/lib:build", "generate-version"],
      "outputs": ["{workspaceRoot}/cli/dist"],
      "options": {
        "tsConfig": "cli/tsconfig.json",
        "main": "cli/src/application/services/main-app-service.ts",
        "outputPath": "cli/dist",
        "clean": false
      }
    },
    "copyTemplates": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": [
        "{workspaceRoot}/cli/dist/public",
        "{workspaceRoot}/cli/dist/src/domain/services/templates",
        "{workspaceRoot}/cli/dist/src/infrastructure/frameworks/templates"
      ],
      "options": {
        "commands": [
          "cpx \"../gh-pages/public/templates/**/*.hbs\" dist/public/templates",
          "cpx \"../gh-pages/public/templates/domain/services/templates/**/*.hbs\" dist/src/domain/services/templates",
          "cpx \"../gh-pages/public/templates/infrastructure/frameworks/templates/**/*.hbs\" dist/src/infrastructure/frameworks/templates"
        ],
        "cwd": "cli"
      }
    },
    "bundle-lib": {
      "executor": "nx:run-commands",
      "dependsOn": ["@onion-initializr/lib:build"],
      "outputs": [
        "{workspaceRoot}/cli/dist/node_modules/@onion-initializr/lib"
      ],
      "options": {
        "command": "node bundle-lib.js",
        "cwd": "cli"
      }
    },
    "build-all": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "bundle-lib", "copyTemplates"],
      "options": {
        "commands": ["echo CLI build complete with bundled lib and templates"],
        "cwd": "cli"
      }
    },
    "link": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-all"],
      "options": {
        "commands": ["pnpm add -g ."],
        "cwd": "cli"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cross-env TS_NODE_PROJECT=tsconfig.test.json c8 --all --include=\"src/**/*.ts\" --reporter=text --reporter=html mocha --require ts-node/register src/**/*.test.ts"
        ],
        "cwd": "cli"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["playwright test"],
        "cwd": "cli"
      }
    }
  }
}
